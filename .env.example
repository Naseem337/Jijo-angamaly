# Copy to .env and fill in. Never commit .env.
#
# Secret names used in clients/*/client.yaml are mapped to env vars locally:
#   "truechoice/whatsapp_token" -> TRUECHOICE_WHATSAPP_TOKEN
# (upper-case, every non-alphanumeric character becomes "_").

APP_ENV=local
LOG_LEVEL=INFO
CLIENTS_DIR=clients
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/app.sqlite3
# Signs dashboard session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# --- LLM providers (shared across clients) ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Fill in the current Claude Haiku model ID yourself (deliberately not hardcoded).
ANTHROPIC_MODEL=
# OpenRouter model slug used as the 2nd fallback, e.g. a DeepSeek or Llama slug.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Only needed if you add gemini to llm_chain.
GEMINI_MODEL=

# --- Speech (Sarvam) ---
SARVAM_API_KEY=
# Optional overrides (defaults in clients/truechoice/client.yaml)
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=anushka

# --- True Choice: WhatsApp Cloud API ---
TRUECHOICE_WHATSAPP_PHONE_NUMBER_ID=
TRUECHOICE_WHATSAPP_TOKEN=
TRUECHOICE_WHATSAPP_APP_SECRET=
TRUECHOICE_WHATSAPP_VERIFY_TOKEN=
# Staff numbers allowed to use RESUME / WISH (comma-separated)
TRUECHOICE_STAFF_NUMBERS=
# Dashboard login password for True Choice staff.
TRUECHOICE_DASHBOARD_PASSWORD=
